# ==============================================================================
# GITM Gurgaon - Global Institute of Technology & Management
# Environment Variables Configuration
# ==============================================================================

# 1. Database Connection URL
# Local SQLite for offline development:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (e.g. Supabase, Neon, AWS RDS, GCP Cloud SQL):
# DATABASE_URL="postgresql://gitm_user:secure_password@db-host:5432/gitm_production?schema=public&sslmode=require"

# 2. Automated Sync & Cron Security Token
# Protects GET/POST /api/sync endpoint from unauthorized execution.
# On Vercel Cron, configure CRON_SECRET in Project Settings > Environment Variables:
CRON_SECRET="your-high-entropy-secure-cron-secret-here-2026"

# 3. Canonical Application Public Base URL
# Used for OpenGraph metadata, sitemap.xml, robots.txt, and canonical URLs:
NEXT_PUBLIC_APP_URL="https://gitm.ac.in"
