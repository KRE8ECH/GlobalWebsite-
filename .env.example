# ==============================================================================
# GITM Gurugram — environment variables
# ==============================================================================
# The site runs with ZERO configuration. Everything below is optional and only
# adds capability. Do not commit a real .env file.
# ==============================================================================

# 1. Canonical public URL — used for canonical tags, OpenGraph, sitemap, robots.
#    Set this to the production domain in Vercel.
NEXT_PUBLIC_APP_URL="https://gitmgurgaon.com"

# ------------------------------------------------------------------------------
# 2. OPTIONAL: database
# ------------------------------------------------------------------------------
# When set, freshly synced notices / events / placements from the database
# override the curated static content in src/data/*. When unset, the site renders
# the static content and works perfectly.
#
# Must be PostgreSQL. (The old SQLite datasource could not run on Vercel.)
# Free options: Neon, Supabase, Vercel Postgres.
# DATABASE_URL="postgresql://user:password@host:5432/gitm?sslmode=require"

# ------------------------------------------------------------------------------
# 3. OPTIONAL: inquiry email delivery
# ------------------------------------------------------------------------------
# Without these, inquiries are stored in the database (if configured) and always
# written to the server log. With Resend configured, every inquiry is also
# emailed to the admissions desk, so a lead is never lost.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# INQUIRY_EMAIL_TO="admission@gitmgurgaon.com"
# INQUIRY_EMAIL_FROM="GITM Website <website@gitmgurgaon.com>"

# ------------------------------------------------------------------------------
# 4. OPTIONAL: notice sync endpoint authentication
# ------------------------------------------------------------------------------
# Only needed if you enable the scheduled university-notice sync.
# CRON_SECRET="a-long-random-string"
