generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Matches src/data/site.ts and the enums used across the UI.
// Note: SQLite could not run on Vercel's serverless filesystem, which is why
// this datasource is PostgreSQL (Neon / Supabase / Vercel Postgres).

enum NoticeCategory {
  EXAM
  ADMISSION
  ACADEMIC
  HOLIDAY
  GENERAL
}

enum NoticeSource {
  GITM
  GURUGRAM_UNIVERSITY
}

enum Department {
  ENGINEERING
  MANAGEMENT
  PHARMACY
  COMPUTER_APPLICATIONS
}

enum ProgramLevel {
  UG
  PG
  DIPLOMA
  LEET
}

enum InquiryStatus {
  PENDING
  CONTACTED
  CLOSED
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  category    NoticeCategory
  source      NoticeSource   @default(GITM)
  publishDate DateTime       @default(now())
  pdfUrl      String?
  sourceUrl   String?
  /// SHA-256 of the normalised title — the scraper's idempotency key.
  titleHash   String?        @unique
  isPinned    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@index([source])
  @@index([publishDate])
}

model Program {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  department     Department
  level          ProgramLevel
  durationYears  Int
  eligibility    String
  intake         Int
  syllabusPdfUrl String?
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([department])
  @@index([level])
}

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  date      DateTime
  location  String
  imageUrl  String?
  /// Comma-separated tags, e.g. "Tech,Hackathon,AI"
  tags      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model PlacementHighlight {
  id          String   @id @default(cuid())
  studentName String
  company     String
  packageLPA  Float
  designation String
  year        Int
  branch      String
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([company])
}

model Inquiry {
  id                   String        @id @default(cuid())
  fullName             String
  email                String
  phone                String
  courseInterested     String
  state                String
  highestQualification String?
  message              String?
  status               InquiryStatus @default(PENDING)
  /// Where the lead came from: hero form, inquiry modal, programme page, etc.
  source               String?
  /// Set when the lead could not be persisted and only the email fallback ran.
  deliveryStatus       String        @default("stored")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}
